{
  "expo": {
    "name": "京美AI助手",
    "slug": "techdocs-ai",
    "owner": "cjtallen",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "techdocsai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chenjingtao.techdocsai",
      "appleTeamId": ""
    },
    "android": {
      "package": "com.yourorg.techdocsai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#e9ecfb"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-sqlite",
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许「京美AI助手」访问相册，以便把现场照片或样品图片作为附件随问答一起携带。",
          "cameraPermission": "允许「京美AI助手」使用相机拍摄样品照片作为附件。"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "用面容解锁「京美AI助手」—— 资料与提问都在手机里，看一眼就能打开，不用每次输密码。"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9a87b308-4852-425b-b925-b5196a866107"
      }
    }
  }
}
