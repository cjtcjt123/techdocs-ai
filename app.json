{
  "expo": {
    "name": "技术资料AI助手",
    "slug": "techdocs-ai",
    "owner": "cjtallen",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "techdocsai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chenjingtao.techdocsai",
      "appleTeamId": ""
    },
    "android": {
      "package": "com.yourorg.techdocsai"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许「技术资料AI助手」访问相册，以便把现场照片或样品图片作为附件随问答一起携带。",
          "cameraPermission": "允许「技术资料AI助手」使用相机拍摄样品照片作为附件。"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9a87b308-4852-425b-b925-b5196a866107"
      }
    }
  }
}
